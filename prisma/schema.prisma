generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN COMPANY CREATOR
}
enum CampaignStatus {
  DRAFT PUBLISHED ACTIVE IN_PROGRESS COMPLETED CANCELLED
}
enum ApplicationStatus {
  PENDING ACCEPTED REJECTED NEGOTIATING
}
enum ContractStatus {
  DRAFT ACTIVE DELIVERED APPROVED COMPLETED CANCELLED
}
enum TransactionType {
  DEPOSIT WITHDRAWAL PAYMENT COMMISSION REFUND EARNING
}
enum TransactionStatus {
  PENDING COMPLETED FAILED
}
enum LeadStatus {
  NEW CONTACTED INTERESTED CONVERTED LOST
}
enum NotificationType {
  PROPOSAL MESSAGE PAYMENT CAMPAIGN REVIEW WITHDRAWAL ADMIN
}
enum AdStatus {
  DRAFT ACTIVE PAUSED EXPIRED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String?
  passwordHash String
  role Role
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company?
  creator Creator?
  notifications Notification[]
  messages Message[]
}

model Company {
  id String @id @default(cuid())
  userId String @unique
  name String
  logo String?
  description String?
  category String?
  location String?
  website String?
  phone String?
  socials Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  campaigns Campaign[]
  leads Lead[]
  wallet Wallet?
  reviews Review[]
  advertisements Advertisement[]
}

model Creator {
  id String @id @default(cuid())
  userId String @unique
  displayName String
  username String @unique
  avatar String?
  bio String?
  location String?
  niche String?
  followers Int @default(0)
  engagement Float @default(0)
  basePrice Decimal @db.Decimal(12, 2)
  availability Boolean @default(true)
  verified Boolean @default(false)
  portfolio Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  socials CreatorSocialAccount[]
  applications CampaignApplication[]
  contracts Contract[]
  wallet Wallet?
  reviews Review[]
}

model CreatorSocialAccount {
  id String @id @default(cuid())
  creatorId String
  platform String
  handle String
  followers Int @default(0)
  engagement Float @default(0)
  url String?
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  @@index([platform])
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
}

model Product {
  id String @id @default(cuid())
  companyId String
  name String
  description String?
  price Decimal?
  image String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  advertisements Advertisement[]
}

model Campaign {
  id String @id @default(cuid())
  companyId String
  name String
  description String?
  objective String
  budget Decimal @db.Decimal(12, 2)
  startDate DateTime
  endDate DateTime
  location String?
  audience Json?
  platforms String[]
  creatorCount Int @default(1)
  briefing String?
  status CampaignStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  productId String?
  applications CampaignApplication[]
  contracts Contract[]
  analytics Analytics[]
  leads Lead[]
  advertisements Advertisement[]
  @@index([companyId, status])
}

model CampaignApplication {
  id String @id @default(cuid())
  campaignId String
  creatorId String
  proposedPrice Decimal @db.Decimal(12, 2)
  message String?
  status ApplicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  @@unique([campaignId, creatorId])
}

model Contract {
  id String @id @default(cuid())
  campaignId String
  creatorId String
  agreedAmount Decimal @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  status ContractStatus @default(DRAFT)
  deliverables Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Message {
  id String @id @default(cuid())
  senderId String
  receiverId String
  content String
  readAt DateTime?
  createdAt DateTime @default(now())
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([receiverId, createdAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model Wallet {
  id String @id @default(cuid())
  companyId String? @unique
  creatorId String? @unique
  available Decimal @default(0) @db.Decimal(14, 2)
  pending Decimal @default(0) @db.Decimal(14, 2)
  totalSpent Decimal @default(0) @db.Decimal(14, 2)
  totalReceived Decimal @default(0) @db.Decimal(14, 2)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id String @id @default(cuid())
  walletId String
  type TransactionType
  status TransactionStatus
  amount Decimal @db.Decimal(14, 2)
  reference String @unique
  description String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], on