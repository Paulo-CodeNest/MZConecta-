generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMIN COMPANY CREATOR }
enum CampaignStatus { DRAFT PUBLISHED ACTIVE IN_PROGRESS COMPLETED CANCELLED }
enum ApplicationStatus { PENDING ACCEPTED REJECTED NEGOTIATING }
enum ContractStatus { DRAFT ACTIVE DELIVERED APPROVED COMPLETED CANCELLED }
enum TransactionType { DEPOSIT WITHDRAWAL PAYMENT COMMISSION REFUND EARNING }
enum TransactionStatus { PENDING COMPLETED FAILED }
enum LeadStatus { NEW CONTACTED INTERESTED CONVERTED LOST }
enum NotificationType { PROPOSAL MESSAGE PAYMENT CAMPAIGN REVIEW WITHDRAWAL ADMIN }
enum AdStatus { DRAFT ACTIVE PAUSED EXPIRED }

model User { id String @id @default(cuid()) name String email String @unique phone String? passwordHash String role Role isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt company Company? creator Creator? notifications Notification[] messages Message[] }
model Company { id String @id @default(cuid()) userId String @unique name String logo String? description String? category String? location String? website String? phone String? socials Json? user User @relation(fields:[userId],references:[id],onDelete:Cascade) products Product[] campaigns Campaign[] leads Lead[] wallet Wallet? reviews Review[] advertisements Advertisement[] }
model Creator { id String @id @default(cuid()) userId String @unique displayName String username String @unique avatar String? bio String? location String? niche String? followers Int @default(0) engagement Float @default(0) basePrice Decimal @db.Decimal(12,2) availability Boolean @default(true) verified Boolean @default(false) portfolio Json? user User @relation(fields:[userId],references:[id],onDelete:Cascade) socials CreatorSocialAccount[] applications CampaignApplication[] contracts Contract[] wallet Wallet? reviews Review[] }
model CreatorSocialAccount { id String @id @default(cuid()) creatorId String platform String handle String followers Int @default(0) engagement Float @default(0) url String? creator Creator @relation(fields:[creatorId],references:[id],onDelete:Cascade) @@index([platform]) }
model Category { id String @id @default(cuid()) name String @unique slug String @unique }
model Product { id String @id @default(cuid()) companyId String name String description String? price Decimal? image String? company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) campaigns Campaign[] advertisements Advertisement[] }
model Campaign { id String @id @default(cuid()) companyId String name String description String? objective String budget Decimal @db.Decimal(12,2) startDate DateTime endDate DateTime location String? audience Json? platforms String[] creatorCount Int @default(1) briefing String? status CampaignStatus @default(DRAFT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) product Product? productId String? applications CampaignApplication[] contracts Contract[] analytics Analytics[] leads Lead[] advertisements Advertisement[] @@index([companyId,status]) }
model CampaignApplication { id String @id @default(cuid()) campaignId String creatorId String proposedPrice Decimal @db.Decimal(12,2) message String? status ApplicationStatus @default(PENDING) createdAt DateTime @default(now()) campaign Campaign @relation(fields:[campaignId],references:[id],onDelete:Cascade) creator Creator @relation(fields:[creatorId],references:[id],onDelete:Cascade) @@unique([campaignId,creatorId]) }
model Contract { id String @id @default(cuid()) campaignId String creatorId String agreedAmount Decimal @db.Decimal(12,2) commission Decimal @db.Decimal(12,2) status ContractStatus @default(DRAFT) deliverables Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt campaign Campaign @relation(fields:[campaignId],references:[id],onDelete:Cascade) creator Creator @relation(fields:[creatorId],references:[id],onDelete:Cascade) }
model Message { id String @id @default(cuid()) senderId String receiverId String content String readAt DateTime? createdAt DateTime @default(now()) sender User @relation(fields:[senderId],references:[id],onDelete:Cascade) @@index([receiverId,createdAt]) }
model Notification { id String @id @default(cuid()) userId String type NotificationType title String body String readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,readAt]) }
model Wallet { id String @id @default(cuid()) companyId String? @unique creatorId String? @unique available Decimal @default(0) @db.Decimal(14,2) pending Decimal @default(0) @db.Decimal(14,2) totalSpent Decimal @default(0) @db.Decimal(14,2) totalReceived Decimal @default(0) @db.Decimal(14,2) company Company? @relation(fields:[companyId],references:[id],onDelete:Cascade) creator Creator? @relation(fields:[creatorId],references:[id],onDelete:Cascade) transactions Transaction[] }
model Transaction { id String @id @default(cuid()) walletId String type TransactionType status TransactionStatus amount Decimal @db.Decimal(14,2) reference String @unique description String? createdAt DateTime @default(now()) wallet Wallet @relation(fields:[walletId],references:[id],onDelete:Cascade) payment Payment? @@index([walletId,createdAt]) }
model Payment { id String @id @default(cuid()) transactionId String @unique provider String method String status TransactionStatus amount Decimal @db.Decimal(14,2) externalReference String? metadata Json? createdAt DateTime @default(now()) transaction Transaction @relation(fields:[transactionId],references:[id],onDelete:Cascade) }
model Withdrawal { id String @id @default(cuid()) creatorId String amount Decimal @db.Decimal(14,2) method String status TransactionStatus destination String? createdAt DateTime @default(now()) }
model Commission { id String @id @default(cuid()) contractId String @unique rate Decimal @db.Decimal(5,2) amount Decimal @db.Decimal(14,2) createdAt DateTime @default(now()) }
model Plan { id String @id @default(cuid()) name String @unique price Decimal @db.Decimal(12,2) features Json active Boolean @default(true) sortOrder Int @default(0) subscriptions Subscription[] }
model Subscription { id String @id @default(cuid()) companyId String planId String status String startDate DateTime endDate DateTime? company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) plan Plan @relation(fields:[planId],references:[id]) @@index([companyId,status]) }
model Lead { id String @id @default(cuid()) companyId String campaignId String? name String phone String? email String? source String? status LeadStatus @default(NEW) createdAt DateTime @default(now()) company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) campaign Campaign? @relation(fields:[campaignId],references:[id]) @@index([companyId,status]) }
model Analytics { id String @id @default(cuid()) campaignId String date DateTime impressions Int @default(0) reach Int @default(0) clicks Int @default(0) engagements Int @default(0) leads Int @default(0) conversions Int @default(0) sales Decimal @default(0) @db.Decimal(14,2) spend Decimal @default(0) @db.Decimal(14,2) campaign Campaign @relation(fields:[campaignId],references:[id],onDelete:Cascade) @@unique([campaignId,date]) }
model Review { id String @id @default(cuid()) companyId String? creatorId String? rating Int comment String? createdAt DateTime @default(now()) company Company? @relation(fields:[companyId],references:[id],onDelete:Cascade) creator Creator? @relation(fields:[creatorId],references:[id],onDelete:Cascade) }
model Advertisement { id String @id @default(cuid()) companyId String campaignId String? productId String? title String budget Decimal @db.Decimal(12,2) status AdStatus @default(DRAFT) startsAt DateTime endsAt DateTime company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) campaign Campaign? @relation(fields:[campaignId],references:[id]) product Product? @relation(fields:[productId],references:[id]) }
model AIGeneration { id String @id @default(cuid()) userId String prompt String output String tool String createdAt DateTime @default(now()) }